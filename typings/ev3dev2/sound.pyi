from typing import Iterable, Tuple

class Sound:
    PLAY_WAIT_FOR_COMPLETE: int
    PLAY_NO_WAIT_FOR_COMPLETE: int
    PLAY_LOOP: int
    def __init__(self) -> None: ...
    def beep(self, args: str = ..., play_type: int = ...): ...
    def get_volume(self, channel = ...) -> int: ...
    def set_volume(self, volume: int, channel = ...) -> None: ...
    def tone(self, *args, play_type: int = ...): ...
    def play_tone(self, frequency: int, duration: float, delay: float = ..., volume: int = ..., play_type: int = ...): ...
    def play_file(self, wav_file: str, volume: int = ..., play_type: int = ...): ...
    def speak(self, text: str, espeak_opts: str = ..., volume: int = ..., play_type: int = ...): ...
