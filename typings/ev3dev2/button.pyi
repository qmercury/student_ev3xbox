from typing import List

class Button:
    buttons_pressed: List[str]
    up: bool
    down: bool
    left: bool
    right: bool
    enter: bool
    backspace: bool
    def __init__(self) -> None: ...
    def any(self) -> bool: ...
    def check_buttons(self, buttons: List[str] = ...) -> bool: ...
    def wait_for_pressed(self, buttons: List[str], timeout_ms: int = ...) -> bool: ...
    def wait_for_released(self, buttons: List[str], timeout_ms: int = ...) -> bool: ...
    def wait_for_bump(self, buttons: List[str], timeout_ms: int = ...) -> bool: ...
    def process(self, new_state = ...) -> None: ...
