from typing import Any

OUTPUT_A: str
OUTPUT_B: str
OUTPUT_C: str
OUTPUT_D: str

class SpeedValue:
    pass

class SpeedPercent(SpeedValue):
    def __init__(self, percent: float, desc: str = ...) -> None: ...

class SpeedRPS(SpeedValue):
    def __init__(self, rotations_per_second: float, desc: str = ...) -> None: ...

class SpeedRPM(SpeedValue):
    def __init__(self, rotations_per_minute: float, desc: str = ...) -> None: ...

class SpeedDPS(SpeedValue):
    def __init__(self, degrees_per_second: float, desc: str = ...) -> None: ...

class SpeedDPM(SpeedValue):
    def __init__(self, degrees_per_minute: float, desc: str = ...) -> None: ...

class Motor:
    address: str
    driver_name: str
    position: int
    speed: int
    polarity: str
    state: list
    is_running: bool
    is_holding: bool
    is_stalled: bool

    POLARITY_NORMAL: str
    POLARITY_INVERSED: str

    def __init__(self, address: str = ..., **kwargs: Any) -> None: ...
    def on(self, speed: Any, brake: bool = ..., block: bool = ...) -> None: ...
    def off(self, brake: bool = ...) -> None: ...
    def stop(self, **kwargs: Any) -> None: ...
    def reset(self, **kwargs: Any) -> None: ...
    def on_for_seconds(self, speed: Any, seconds: float, brake: bool = ..., block: bool = ...) -> None: ...
    def on_for_degrees(self, speed: Any, degrees: float, brake: bool = ..., block: bool = ...) -> None: ...
    def on_for_rotations(self, speed: Any, rotations: float, brake: bool = ..., block: bool = ...) -> None: ...
    def on_to_position(self, speed: Any, position: float, brake: bool = ..., block: bool = ...) -> None: ...
    def wait_until_not_moving(self, timeout: int = ...) -> bool: ...

class LargeMotor(Motor): ...
class MediumMotor(Motor): ...

class MoveTank:
    left_motor: Motor
    right_motor: Motor
    gyro: Any
    def __init__(self, left_motor_port: str, right_motor_port: str, desc: str = ..., motor_class: Any = ...) -> None: ...
    def on(self, left_speed: Any, right_speed: Any) -> None: ...
    def off(self, brake: bool = ...) -> None: ...
    def stop(self, brake: bool = ...) -> None: ...
    def on_for_seconds(self, left_speed: Any, right_speed: Any, seconds: float, brake: bool = ..., block: bool = ...) -> None: ...
    def on_for_degrees(self, left_speed: Any, right_speed: Any, degrees: float, brake: bool = ..., block: bool = ...) -> None: ...
    def on_for_rotations(self, left_speed: Any, right_speed: Any, rotations: float, brake: bool = ..., block: bool = ...) -> None: ...
    def turn_degrees(self, speed: Any, target_angle: float, brake: bool = ..., error_margin: float = ..., sleep_time: float = ...) -> None: ...
    def turn_right(self, speed: Any, degrees: float, brake: bool = ..., error_margin: float = ..., sleep_time: float = ...) -> None: ...
    def turn_left(self, speed: Any, degrees: float, brake: bool = ..., error_margin: float = ..., sleep_time: float = ...) -> None: ...

class MoveSteering(MoveTank):
    def on(self, steering: float, speed: Any) -> None: ...
    def on_for_seconds(self, steering: float, speed: Any, seconds: float, brake: bool = ..., block: bool = ...) -> None: ...
    def on_for_degrees(self, steering: float, speed: Any, degrees: float, brake: bool = ..., block: bool = ...) -> None: ...
    def on_for_rotations(self, steering: float, speed: Any, rotations: float, brake: bool = ..., block: bool = ...) -> None: ...

class MoveJoystick(MoveTank):
    def on(self, x: float, y: float, radius: float = ...) -> None: ...

class MoveDifferential(MoveTank):
    x_pos_mm: float
    y_pos_mm: float
    theta: float
    def __init__(self, left_motor_port: str, right_motor_port: str, wheel_class: Any, wheel_distance_mm: float, desc: str = ..., motor_class: Any = ...) -> None: ...
    def on_for_distance(self, speed: Any, distance_mm: float, brake: bool = ..., block: bool = ...) -> None: ...
    def on_arc_right(self, speed: Any, radius_mm: float, distance_mm: float, brake: bool = ..., block: bool = ...) -> None: ...
    def on_arc_left(self, speed: Any, radius_mm: float, distance_mm: float, brake: bool = ..., block: bool = ...) -> None: ...
    def turn_degrees(self, speed: Any, degrees: float, brake: bool = ..., block: bool = ..., error_margin: float = ..., use_gyro: bool = ...) -> None: ...
    def turn_right(self, speed: Any, degrees: float, brake: bool = ..., block: bool = ..., error_margin: float = ..., use_gyro: bool = ...) -> None: ...
    def turn_left(self, speed: Any, degrees: float, brake: bool = ..., block: bool = ..., error_margin: float = ..., use_gyro: bool = ...) -> None: ...
    def turn_to_angle(self, speed: Any, angle_target_degrees: float, brake: bool = ..., block: bool = ..., error_margin: float = ..., use_gyro: bool = ...) -> None: ...
    def odometry_start(self, theta_degrees_start: float = ..., x_pos_start: float = ..., y_pos_start: float = ..., sleep_time: float = ...) -> None: ...
    def odometry_stop(self) -> None: ...
    def on_to_coordinates(self, speed: Any, x_target_mm: float, y_target_mm: float, brake: bool = ..., block: bool = ...) -> None: ...
