from typing import Any, Tuple

class Display:
    xres: int
    yres: int
    shape: Tuple[int, int]
    draw: Any
    image: Any
    def __init__(self, desc: str = ...) -> None: ...
    def clear(self) -> None: ...
    def update(self) -> None: ...
    def line(self, clear_screen: bool = ..., x1: int = ..., y1: int = ..., x2: int = ..., y2: int = ..., line_color: str = ..., width: int = ...) -> None: ...
    def point(self, clear_screen: bool = ..., x: int = ..., y: int = ..., point_color: str = ...) -> None: ...
